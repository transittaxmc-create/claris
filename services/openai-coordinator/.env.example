# Copiloto V7 — OpenAI Coordinator (preview). Copy to .env locally or set as
# service variables in Railway. NEVER commit a real .env file.
# Every value below is a PLACEHOLDER, not a real secret.

# OpenAI API key (server secret). Deposited by Miguel; never in the repo.
OPENAI_API_KEY=sk-REPLACE_WITH_YOUR_OPENAI_API_KEY

# The Coordinator's OWN Agent Gateway machine key (x-agent-key header).
# Separate identity from `Muse` and from `chatgpt`. Created in the CRM
# Supabase agent_identities table; only its SHA-256 hash is stored there.
# The raw value lives in Supabase Vault + this service's secret store only.
COORDINATOR_GATEWAY_KEY=REPLACE_WITH_COORDINATOR_GATEWAY_KEY

# Agent Gateway endpoint (Supabase Edge Function, CRM project).
GATEWAY_URL=https://mimgwleghecseoymgdug.supabase.co/functions/v1/agent-gateway

# OpenAI API base (override only for tests/proxies).
OPENAI_BASE_URL=https://api.openai.com/v1

# Any Responses-API capable model id on the account.
OPENAI_MODEL=gpt-5

# Poll interval for inbox/tasks/continuity, milliseconds (min 250).
POLL_INTERVAL_MS=15000

# Max OpenAI tool-calling steps per instruction.
MAX_TOOL_STEPS=8

# Per-request timeout, milliseconds.
REQUEST_TIMEOUT_MS=30000
