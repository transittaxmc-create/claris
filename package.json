{
  "name": "my-project",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "next dev",
    "build": "pnpm run typecheck && pnpm run test:crm-push && pnpm run test:agent-gateway && next build",
